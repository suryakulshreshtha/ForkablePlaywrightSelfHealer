# Copy to .env and source it, or export these directly.

FORKABLE_OFFLINE=1                  # arm the loopback-only socket guard
OLLAMA_HOST=http://127.0.0.1:11434
FORKABLE_LLM_MODEL=qwen2.5-coder:14b
FORKABLE_EMBED_MODEL=nomic-embed-text
FORKABLE_LLM_PROVIDER=ollama        # set to "none" to force the deterministic engine
FORKABLE_EMBEDDER=auto              # auto | ollama | hashing
FORKABLE_BROWSER=chromium
FORKABLE_HEADLESS=1
FORKABLE_APP_PORT=8799

# Point at a pre-seeded browser bundle on an air-gapped machine:
# PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers

# Set to any value to see full tracebacks from the CLI:
# FORKABLE_TRACEBACK=1

# Browser hardening (all optional)
# FORKABLE_IGNORE_HTTPS_ERRORS=0    # 1 = accept self-signed certificates
# FORKABLE_NO_SANDBOX=auto          # auto | always | never
